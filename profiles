from db import get_db

def get_profile(user_id):
    db = get_db()
    cur = db.cursor()

    cur.execute("""
        select u.username, p.display_name, p.avatar_url, p.bio, p.is_admin
        from users u
        left join profiles p on u.id = p.user_id
        where u.id = %s
    """, (user_id,))

    profile = cur.fetchone()
    cur.close()
    db.close()
    return profile


def update_profile(user_id, display_name, avatar_url, bio):
    db = get_db()
    cur = db.cursor()

    cur.execute("""
        insert into profiles (user_id, display_name, avatar_url, bio)
        values (%s,%s,%s,%s)
        on conflict (user_id)
        do update set
            display_name = excluded.display_name,
            avatar_url = excluded.avatar_url,
            bio = excluded.bio
    """, (user_id, display_name, avatar_url, bio))

    db.commit()
    cur.close()
    db.close()
